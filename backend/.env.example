# Step 14.2.3.C.2 —— 开发配置模板（与 Settings 字段面**一一对齐**：10 键 = 10 字段）。
#
# 三层配置源（不是三个互相竞争的配置源，而是三个层次）：
#   1. app/core/config.py      —— 配置**契约**（字段面 + 默认值 + 边界校验）；
#   2. backend/.env.example    —— **开发**配置模板（本文件；复制为 backend/.env 生效，
#                                 backend/.env 已被 .gitignore 忽略，绝不可提交）；
#   3. docker-compose.yml      —— **Pilot deployment overrides**（部署入口，明确声明
#                                 Pilot runtime 的运行配置）。
#
# 值纪律：本模板所有值 = Settings 代码内默认值（复制后即开发友好默认），
# 任何键留空或删除 = 回落到代码默认。
#
# 注意：TENCENT_ACP_* 等键**不属于**本模板——它们是 env-gated live test 的
# test-only configuration，不是 application runtime configuration
# （真实冒烟测试经其自身测试配置管理，见 tests/test_step10_1_3_tencent_acp_wire.py）。

APP_NAME=Agent Control Plane
# 与 Pilot 持久化路径统一（14.2.3.C.2）；相对 WORKDIR backend/，
# data/ 目录随仓库保留（.gitkeep）。仍可在本文件显式覆盖。
DATABASE_URL=sqlite:///./data/agent_control_plane.db
ENVIRONMENT=development

# --- Cloud-0.1.1-C：Browser Auth 强制开关（唯一认证开关） ---
# False（默认）= OSS / 本地单租户：无 Cookie 回退 TENANT_LOCAL（行为不变）；
# True（Cloud 多租户）= 无 Cookie / 无效 Cookie → 401。
AUTH_REQUIRED=false

# --- Production Driver 节奏（12.9.4.16；只有节奏与批量，没有任何业务语义） ---
# DRIVER_RECLAIM_EVERY = 「每多少轮做一次回收」的 cadence，
# 与 DRIVER_STALE_THRESHOLD_SECONDS（「多老算孤儿」，Core 语义）严格分离。
DRIVER_POLL_INTERVAL_SECONDS=2.0
DRIVER_PICKUP_LIMIT=10
DRIVER_RECLAIM_EVERY=30
DRIVER_STALE_THRESHOLD_SECONDS=300
DRIVER_BACKOFF_INTERVAL_SECONDS=5.0

# --- P0：WeCom 智能机器人 ACK 等待窗口（发帧 → 等待 errcode 回执） ---
# 默认 10.0s = 既有硬编码常量逐字搬来（零行为变化，仅变为可配置项）。
# 该窗口只覆盖「发帧→ACK」，与 Agent 执行时长互不叠加、互不换算。
WECOM_BOT_ACK_WAIT_TIMEOUT_SECONDS=10.0

# --- P2 Delivery Recovery（投递恢复驱动；**默认关闭**）---
# 启用顺序见 docs/step-p2-delivery-recovery-implementation.md 的 runbook。
RECOVERY_ENABLED=false
RECOVERY_POLL_INTERVAL_SECONDS=10.0
RECOVERY_PICKUP_LIMIT=10
RECOVERY_RECLAIM_EVERY=30
# 租约长度：保守默认值，未经生产实测（待 P4）；须 > 发送上界 + ACK 窗口 + 余量
RECOVERY_LEASE_SECONDS=300
# 总 attempt 次数上限（含首次投递）
RECOVERY_MAX_ATTEMPTS=3
